ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Orígenes de navegador permitidos para peticiones con cookie de sesión (separados por coma).
# Server-to-server con X-API-Key no pasa por CORS, no necesita estar aquí.
ALLOWED_ORIGINS=https://app.tudominio.com,https://frontend-equipo.tudominio.com

# Rate limiting (por IP o por API key, en memoria del proceso)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ANALYZE_PER_MINUTE=20

# Tamaño máximo por imagen subida, en bytes (15 MB por defecto)
MAX_UPLOAD_BYTES=15728640
